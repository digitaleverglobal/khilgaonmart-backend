DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=3306
REFRESH_SECRET=change_me_refresh_secret
TOKEN_SECRET=change_me_token_secret
NODE_ENV="production"
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret
WOOCOMMERCE_SITE_URL=https://your-woocommerce-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret


SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME="Holy Deen"
MAIL_FROM_EMAIL=""
MAIL_BRAND_NAME="Holy Deen"
MAIL_SUPPORT_EMAIL=""
APP_LOGIN_URL="https://kafelamart.digitalever.com.bd/login"
ORIGIN_URL="https://kafelamart.digitalever.com.bd"
# APP_BASE_URL="kafelamart.digitalever.com.bd"
APP_BASE_URL="kafelamart.digitalever.com.bd"
NOTIFICATION_EMAIL_ENABLED=true

# Absolute path to store uploaded images/PDFs (banners, product images, etc).
# MUST point OUTSIDE the git-deployed app folder (Hostinger rebuilds under
# hbuilds/ on every deploy) so files survive redeploys. Leave unset locally
# to use the default ./images folder.
# Production (Hostinger, set via Node.js app Environment Variables panel):
# UPLOAD_DIR="/home/u172109161/uploads"
UPLOAD_DIR=""


# Meta Conversions API version (provider credentials are stored from the dashboard)
META_GRAPH_API_VERSION="v23.0"


# Google Ads server-side conversion upload credentials
#আপনার কাজ শুধু Google Ads account-এ Auto-tagging ON রাখা।
# Path সাধারণত:
# Google Ads → Admin → Account settings → Auto-tagging →
# Tag the URL that people click through from my ad ON

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Shared secret with the Next.js frontend (same value in its PROXY_SECRET).
# The backend trusts the customer IP the frontend forwards only when this matches.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
# Reverse proxies (nginx etc.) directly in front of this backend; 0 if none.
TRUST_PROXY_HOPS=0
